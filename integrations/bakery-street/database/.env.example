# Energetic Lexicon Database - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to git!

# ============================================================================
# ENCRYPTION
# ============================================================================

# Path to GPG vault password file
VAULT_PASSWORD_FILE=~/.primax_vault_password

# GPG key ID (optional - uses default if not specified)
# GPG_KEY_ID=your-gpg-key-id

# Encryption algorithm (default: AES256)
ENCRYPTION_ALGO=AES256

# ============================================================================
# DATABASE
# ============================================================================

# Database type (sqlite or postgresql)
DB_TYPE=sqlite

# SQLite database path (relative to project root)
DB_PATH=data/lexicon.db

# PostgreSQL connection (if using postgres instead of sqlite)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=energetic_lexicon
# POSTGRES_USER=lexicon_user
# POSTGRES_PASSWORD=your-secure-password

# ============================================================================
# VECTOR STORE (ChromaDB)
# ============================================================================

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# API CONFIGURATION
# ============================================================================

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# JWT secret key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-jwt-secret-key-here-replace-this

# JWT token expiration (in seconds, default 1 hour)
JWT_EXPIRATION=3600

# API rate limiting (requests per minute)
RATE_LIMIT=60

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

# GitHub personal access token (for baker-search)
# Requires: repo, read:org, read:user scopes
GITHUB_TOKEN=your-github-token-here

# GitHub organization name
GITHUB_ORG=Bakery-street-project

# ============================================================================
# NOTION INTEGRATION (OPTIONAL)
# ============================================================================

# Notion API key (from https://www.notion.so/my-integrations)
# NOTION_API_KEY=secret_your_notion_api_key

# Notion parent page ID (where databases will be created)
# NOTION_PARENT_PAGE_ID=your-page-id-here

# ============================================================================
# LOGGING & AUDIT
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/lexicon.log

# Audit log path (encrypted)
AUDIT_LOG_FILE=logs/audit.log

# Enable audit logging (true/false)
AUDIT_ENABLED=true

# ============================================================================
# BACKUP & SYNC
# ============================================================================

# Encrypted backup directory
BACKUP_DIR=encrypted_backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Auto-backup frequency (cron format: "0 2 * * *" = daily at 2am)
BACKUP_SCHEDULE="0 2 * * *"

# ============================================================================
# SECURITY
# ============================================================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# IP whitelist for API access (comma-separated, empty = allow all)
# IP_WHITELIST=127.0.0.1,192.168.1.0/24

# API key rotation interval (days)
API_KEY_ROTATION_DAYS=30

# ============================================================================
# PRIMAX INTEGRATION
# ============================================================================

# PRIMAX API endpoint
# PRIMAX_API_URL=http://localhost:8000/api

# PRIMAX API key
# PRIMAX_API_KEY=your-primax-api-key

# ============================================================================
# AGENTICSEEK INTEGRATION (AGPL-3.0)
# ============================================================================

# AgenticSeek plugin endpoint
# AGENTICSEEK_URL=http://localhost:5000

# Enable AgenticSeek integration
# AGENTICSEEK_ENABLED=false

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Hot reload (true/false)
HOT_RELOAD=true

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
