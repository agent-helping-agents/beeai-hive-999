# Codex-SuperLab Environment Variables
# Copy this to .env and fill in your actual values

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API (Use your Pro subscription)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_PATH=path_to_your_service_account.json

# Gmail Configuration  
GMAIL_EMAIL=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# OpenAI API (Optional - use Gemini instead)
OPENAI_API_KEY=optional_openai_key

# Stripe Payment Processing
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Database (Optional - uses SQLite by default)
DATABASE_URL=sqlite:///codex_superlab.db

# Application Settings
DEBUG=False
PORT=8000
HOST=0.0.0.0