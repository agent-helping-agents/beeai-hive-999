# ============================================================================
# PROJECT SPECIFIC
# ============================================================================

# Product archives (stored separately for upload)
PRODUCTS_TO_SELL/*.tar.gz
PRODUCTS_TO_SELL/*.zip

# Gumroad upload artifacts
gumroad_uploads/

# Test output
test_output/
*.test.log

# Monitoring
monitoring/
*.metrics

# ============================================================================
# EXCEPTIONS (Force Include)
# ============================================================================

# Example/template .env files (safe to commit)
!.env.example
!.env.template

# License files (must be included)
!LICENSE
!LICENSE.*

# Documentation
!README.md
!SECURITY.md
!CONTRIBUTING.md

