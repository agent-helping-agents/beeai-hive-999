# Universal Treasury Payment API Docker Image
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o payment-api ./main.go

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/payment-api /usr/local/bin/payment-api

# Make binary executable
RUN chmod +x /usr/local/bin/payment-api

# Set entrypoint
ENTRYPOINT ["payment-api"]

# Default command
CMD ["transactions", "serve"]

# Metadata
LABEL maintainer="Universal Treasury <support@universal-treasury.com>"
LABEL version="1.0.0"
LABEL description="Universal Treasury Payment API"
LABEL component="payment-processing"