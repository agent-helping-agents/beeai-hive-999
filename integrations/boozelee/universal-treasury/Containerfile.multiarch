# Universal Treasury CLI - Multi-Architecture Containerfile
# Build with: podman build -t universal-treasury-cli -f Containerfile.multiarch .

ARG PLATFORM=linux/amd64
ARG BINARY=treasury

FROM alpine:latest

# Install dependencies based on platform
RUN apk add --no-cache \
    ca-certificates \
    sqlite \
    && if [ "$PLATFORM" = "linux/arm64" ]; then \
           apk add --no-cache gcompat; \
       fi

# Set working directory
WORKDIR /app

# Copy the correct binary for the platform
COPY ${BINARY} /usr/local/bin/treasury

# Make binary executable
RUN chmod +x /usr/local/bin/treasury

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/treasury"]

# Default command
CMD ["--help"]

# Metadata
LABEL org.opencontainers.image.title="Universal Treasury CLI"
LABEL org.opencontainers.image.description="Universal Financial Operations CLI with Wise integration"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/universal-treasury/cli"
LABEL org.opencontainers.image.licenses="MIT"
LABEL maintainer="Universal Treasury <support@universal-treasury.com>"

# Security: Run as non-root user
RUN adduser -D -s /bin/sh appuser && \
    chown -R appuser:appuser /app

USER appuser