# .env.example for Terminal 221B Monetization Engine

# Solana RPC URL (e.g., from QuickNode, Alchemy, or a private RPC)
# Default: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# AGENT WALLET ADDRESS (Solana public key for the agent's main wallet)
# Used by StakingAgent and other Solana-based agents
AGENT_WALLET_ADDRESS="YOUR_SOLANA_PUBLIC_KEY"

# HACKERONE_IDENTIFIER="your_hackerone_identifier"
# HACKERONE_TOKEN="your_hackerone_api_token"

# BUGCROWD_API_KEY="your_bugcrowd_api_key"

# Add more environment variables as agents are implemented (e.g., API keys for Aave, Compound, etc.)
